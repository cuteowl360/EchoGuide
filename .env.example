# EchoGuide environment variables
# Copy this file to .env and fill in real keys.

# TTS provider: elevenlabs (default) or polly
TTS_PROVIDER=elevenlabs

# Amazon Polly configuration (used when TTS_PROVIDER=polly)
# POLLY_REGION=us-east-1
# POLLY_VOICE_ID=Joanna
# POLLY_ENGINE=neural

# ElevenLabs configuration (used when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# Get a free ORS key at https://openrouteservice.org/dev/#/home (no credit card)
ORS_API_KEY=eyJvcmciOi...

# Optional Gemini key (Google AI Studio)
# GEMINI_API_KEY=

# Optional: override default voice
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaLz

# Guide mode detector engine: aws (default) or yolo
# GUIDE_ENGINE=aws

# Lower values detect farther/smaller objects in guide mode.
# GUIDE_AWS_MIN_CONF=45
# GUIDE_AWS_MAX_LABELS=25
# GUIDE_YOLO_CONF=0.2
# GUIDE_YOLO_MAX=50
