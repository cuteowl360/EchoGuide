# EchoGuide environment variables
# Copy this file to .env and fill in real keys.

ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# Get a free ORS key at https://openrouteservice.org/dev/#/home (no credit card)
ORS_API_KEY=eyJvcmciOi...

# Optional Gemini key (Google AI Studio)
# GEMINI_API_KEY=

# Optional: override default voice
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaLz
